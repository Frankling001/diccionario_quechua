{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020"],
    "verbatimModuleSyntax": false
    // Eliminamos "rootDir" o lo cambiamos a "./" para permitir archivos fuera de src
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts"], // Agregamos la carpeta prisma
  "exclude": ["node_modules", "dist"]
}