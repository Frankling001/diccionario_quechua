generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id          Int        @id @default(autoincrement())
  quechua     String[]   // ✅ Primero (al lado de id)
  spanish     String[]   // ✅ Segundo
  description String?    // ✅ Tercero
  category    Category   // ✅ Cuarto
  examples    Example[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([quechua])
  @@index([spanish])
}

model Example {
  id       Int    @id @default(autoincrement())
  quechua  String
  spanish  String
  wordId   Int
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  quechua     String[]         // ✅ Cambiado
  spanish     String[]         // ✅ Cambiado
  description String?
  category    Category?
  status      SuggestionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum Category {
  SUSTANTIVO
  VERBO
  VERBO_REFLEXIVO
  VERBO_TRANSITIVO
  VERBO_INTRANSITIVO
  VERBO_RECIPROCO
  ADJETIVO
  ADVERBIO
  PRONOMBRE
  PREPOSICION
  CONJUNCION
  INTERJECCION
  ONOMATOPEYA
  EXPRESION
  PARTICULA
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}