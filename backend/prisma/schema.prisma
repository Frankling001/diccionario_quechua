generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Word {
  id          Int        @id @default(autoincrement())
  quechua     String     @unique
  spanish     String[]
  description String?
  category    Category
  examples    Example[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([quechua])
  @@index([category])
}

model Example {
  id       Int    @id @default(autoincrement())
  quechua  String
  spanish  String
  wordId   Int
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Suggestion {
  id          Int              @id @default(autoincrement())
  quechua     String
  spanish     String[]
  description String?
  category    Category?
  status      SuggestionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum Category {
  SUSTANTIVO
  VERBO
  ADJETIVO
  ADVERBIO
  PRONOMBRE
  PREPOSICION
  CONJUNCION
  INTERJECCION
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}